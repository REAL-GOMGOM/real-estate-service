# ============================================================
# 내집(NAEZIP) 환경변수 샘플
# 이 파일은 Git에 커밋됩니다. 실제 값은 .env.local에 저장.
# ============================================================

# --- 데이터베이스 / 맥미니 로컬 원장 ---
# Vercel 런타임용 Neon pooled URL. 실제 비밀번호가 든 URL은 절대 커밋하지 않음.
DATABASE_URL=
# 마이그레이션·점검 등 직접 연결이 꼭 필요한 작업용 Neon unpooled URL.
DATABASE_URL_UNPOOLED=
# macmini-sync.ts가 전체 이력을 먼저 보존하는 로컬 Postgres URL.
NAEZIP_LOCAL_DB_URL=postgresql://LOCAL_USER@localhost:5432/naezip
# sync-and-publish wrapper가 읽을 환경파일. wrapper 실행 전에 export하면 다른 절대경로 사용 가능.
NAEZIP_ENV_FILE=.env.local
# 로컬 원장 백업 목적지. 외장 디스크 또는 암호화 동기화 폴더를 명시.
NAEZIP_BACKUP_DIR=
# 텔레그램 봇 SQLite가 있으면 함께 일관 백업. 미설정 시 PostgreSQL만 백업.
NAEZIP_BOT_SQLITE_PATH=
# 보호된 cron/DB health endpoint 인증값. 생성 예: openssl rand -hex 32
CRON_SECRET=
# Neon → 맥미니 미러는 중복 egress 방지를 위해 기본 비활성화.
# 재해 복구용 일회성 실행에서만 셸 환경에 1을 명시하고, 평상시에는 비워둠.
NAEZIP_ENABLE_NEON_MIRROR=
# 맥미니 → Neon serving-cache write/purge는 별도 opt-in. quota 복구 후 운영자가
# 전송량을 확인하고 명시적으로 1을 지정하기 전까지 client 생성·쓰기·정리를 모두 건너뜀.
NAEZIP_ENABLE_NEON_CACHE_WRITE=

# --- 공개 실거래 serving snapshot (Mac mini publisher → R2/S3) ---
# 브라우저/서버 reader가 manifest를 읽을 공개 베이스 URL. 운영은 R2 custom domain 권장.
NEXT_PUBLIC_TRANSACTION_SNAPSHOT_BASE_URL=https://data.naezipkorea.com/
# 아래 4개는 운영 publisher에 모두 필수. 일부/전체 누락은 실패하며 로컬 sink는 CLI
# `--dry-run`을 명시한 경우에만 허용한다.
NAEZIP_SNAPSHOT_R2_ACCOUNT_ID=
NAEZIP_SNAPSHOT_R2_ACCESS_KEY_ID=
NAEZIP_SNAPSHOT_R2_SECRET_ACCESS_KEY=
NAEZIP_SNAPSHOT_R2_BUCKET=
# Cloudflare R2 기본 endpoint를 쓰면 비워둔다. S3-compatible 테스트 대상에서만 명시.
NAEZIP_SNAPSHOT_R2_ENDPOINT=
# 선택: dry-run 산출물 위치. 실제 원장/백업 디렉터리와 분리하고 Git에 넣지 않는다.
NAEZIP_SNAPSHOT_DRY_RUN_DIR=.local/public-snapshot-dry-run
# sync-and-publish wrapper가 원자적으로 기록하고 production publisher가 확인하는 health marker.
NAEZIP_SYNC_HEALTH_MARKER=.local/macmini-sync-health.json
# 최근 sync 허용 시간(시간 단위, 0 초과 168 이하). 기본 36시간.
NAEZIP_SYNC_HEALTH_MAX_AGE_HOURS=36
# sync 시작부터 manifest 교체 완료까지 wrapper/publisher가 공유하는 exclusive lock.
# 상대경로는 현재 shell cwd가 아니라 저장소 root 기준으로 고정 해석된다.
NAEZIP_SNAPSHOT_LOCK_PATH=.local/public-snapshot-publication.lock

# --- Phase 5f-lite: 카카오 오픈카톡 ---
# 비워두면 플로팅 버튼 + Footer 배너가 렌더링되지 않음 (intentional fail-safe)
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/YOUR_ROOM_ID

# --- 텔레그램 채널 유입 ---
# 공개 채널 URL. 미설정 시 코드의 공식 채널(https://t.me/realMyzip)을 사용.
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/realMyzip

# --- Phase 5d-1: 방문자 트래킹 ---
# SALT는 반드시 32자 이상 랜덤. 생성: openssl rand -hex 16
VISITOR_FINGERPRINT_SALT=generate-32-char-random-string-here
# 관리자 IP (선택). 쉼표 구분. 비워두면 모든 방문 카운트.
ADMIN_IP_ALLOWLIST=

# --- Phase 5d-2: Google Analytics ---
# GA4 Measurement ID (G-XXXXXXXXXX)
# 비워두면 GA4 스크립트가 로드되지 않음 (fail-safe)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Phase 5c-7 Stage 3.5: Google AdSense ---
# Publisher ID (ca-pub-XXXXXXXXXXXXXXXX). 비워두면 광고 로드 안 됨.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Slot ID는 AdSense 승인 후 생성. 비워두면 해당 광고 영역을 숨김.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# Google 인증 CMP 연동 전에는 대한민국 트래픽만 허용(서버 전용 ISO 국가코드 목록).
ADSENSE_ALLOWED_COUNTRIES=KR

# --- Phase 1: 머신 발행 API (텔레그램 봇 → 칼럼 자동 발행) ---
# /api/machine/posts 호출용 Bearer 토큰. CRON_SECRET과 별개(재사용 금지).
# 생성 예: openssl rand -hex 32. 비워두면 머신 발행 API는 500(fail-closed)으로 거부.
MACHINE_PUBLISH_SECRET=

# --- Phase 2: 공개 미리보기 서명 토큰 ---
# /preview/[id]?token= 의 HMAC 서명 키. MACHINE_PUBLISH_SECRET과 별개(유출 격리).
# 생성 예: openssl rand -hex 32. 비워두면 미리보기 토큰 생성/검증이 fail-closed.
PREVIEW_TOKEN_SECRET=
# 미리보기 절대 URL 베이스(봇이 폰에서 열어야 하므로 절대경로 필요).
# 미설정 시 https://www.naezipkorea.com 로 폴백(lib/site.ts). 이미 쓰던 변수 재활용.
NEXT_PUBLIC_SITE_URL=https://www.naezipkorea.com
