# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite DB files
data/*.db
data/*.db-shm
data/*.db-wal
data/raw/
data/processed/
# 학교알리미 수집 원본 (5.8MB — 재생성 가능, 배포 산출물은 schools-map.json만 커밋)
data/school-disclosure.json
.env*.local

# DB 마이그레이션 원문 백업 (커밋 금지 — 글 전문 포함)
scripts/backup/
